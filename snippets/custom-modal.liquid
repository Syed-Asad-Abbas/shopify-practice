{% comment %}
  =============================================================================
  Snippet: Custom Quick View Modal (custom-modal.liquid)
  Description: Desktop Quick View Modal markup, styling, and template structure
               matching Tisso Vison design mockups (Frames 1000009755-1000009760).
  Constraints: Zero frameworks, Zero Dawn components, Vanilla CSS & Vanilla JS.
  =============================================================================
{% endcomment %}

<style>
  /* --- CUSTOM MODAL BACKDROP & CONTAINER --- */
  .tisso-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tisso-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Main Dialog Box */
  .tisso-modal-dialog {
    background-color: #FFFFFF;
    width: 490px;
    max-width: 92vw;
    padding: 34px 34px 36px 34px;
    box-sizing: border-box;
    position: relative;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
    transform: translateY(20px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #111111;
  }

  .tisso-modal-backdrop.is-open .tisso-modal-dialog {
    transform: translateY(0) scale(1);
  }

  /* Close '✕' Button */
  .tisso-modal-close-btn {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111111;
    padding: 0;
    transition: transform 0.2s ease, opacity 0.2s ease;
    z-index: 10;
  }

  .tisso-modal-close-btn:hover {
    transform: rotate(90deg) scale(1.1);
    opacity: 0.7;
  }

  /* Top Product Header Row */
  .tisso-modal-header {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
  }

  .tisso-modal-image-wrapper {
    width: 135px;
    height: 135px;
    flex-shrink: 0;
    background-color: #F8F8F8;
    overflow: hidden;
  }

  .tisso-modal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .tisso-modal-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .tisso-modal-title {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
    color: #111111;
    margin: 0 0 8px 0;
    padding-right: 20px;
    letter-spacing: -0.2px;
  }

  .tisso-modal-price {
    font-size: 18px;
    font-weight: 600;
    color: #111111;
    margin: 0 0 10px 0;
  }

  .tisso-modal-description {
    font-size: 13px;
    line-height: 1.45;
    color: #444444;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Option Section: Color */
  .tisso-option-group {
    margin-bottom: 20px;
  }

  .tisso-option-label {
    display: block;
    font-size: 13.5px;
    font-weight: 500;
    color: #222222;
    margin-bottom: 7px;
  }

  /* Segmented Color Picker (Component 208-211) */
  .tisso-color-segmented-control {
    display: flex;
    width: 100%;
    border: 1px solid #111111;
    box-sizing: border-box;
    background-color: #FFFFFF;
    overflow: hidden;
  }

  .tisso-color-option-btn {
    flex: 1;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 16px 0 0;
    background-color: #FFFFFF;
    color: #000000;
    border: none;
    border-right: 1px solid #111111;
    font-size: 14.5px;
    font-weight: 400;
    cursor: pointer;
    position: relative;
    box-sizing: border-box;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tisso-color-option-btn:last-child {
    border-right: none;
  }

  /* Left vertical color swatch indicator stripe */
  .tisso-color-swatch-bar {
    width: 6px;
    height: 100%;
    margin-right: 14px;
    display: inline-block;
    flex-shrink: 0;
    border-right: 1px solid rgba(0, 0, 0, 0.12);
  }

  /* Selected state */
  .tisso-color-option-btn.is-active {
    background-color: #000000;
    color: #FFFFFF;
  }

  /* Size Dropdown Selector (Component 212 & 213) */
  .tisso-size-select-wrapper {
    position: relative;
    width: 100%;
  }

  .tisso-size-trigger-btn {
    width: 100%;
    height: 40px;
    border: 1px solid #111111;
    background-color: #FFFFFF;
    color: #111111;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    box-sizing: border-box;
    text-align: left;
    transition: border-color 0.2s ease;
  }

  .tisso-size-trigger-btn:hover {
    background-color: #FAFAFA;
  }

  .tisso-size-trigger-btn .tisso-size-chevron {
    transition: transform 0.25s ease;
    display: flex;
    align-items: center;
  }

  .tisso-size-select-wrapper.is-open .tisso-size-trigger-btn .tisso-size-chevron {
    transform: rotate(180deg);
  }

  /* Size Options Dropdown Menu */
  .tisso-size-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #FFFFFF;
    border: 1px solid #111111;
    border-top: none;
    box-sizing: border-box;
    z-index: 50;
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 180px;
    overflow-y: auto;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
  }

  .tisso-size-select-wrapper.is-open .tisso-size-dropdown-menu {
    display: block;
  }

  .tisso-size-dropdown-item {
    padding: 10px 16px;
    font-size: 14px;
    color: #111111;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .tisso-size-dropdown-item:hover {
    background-color: #F2F2F2;
  }

  .tisso-size-dropdown-item.is-active {
    background-color: #000000;
    color: #FFFFFF;
    font-weight: 500;
  }

  /* ADD TO CART Action Button - scaleX wipe animation */
  .tisso-modal-add-to-cart-btn {
    position: relative;
    width: 100%;
    height: 48px;
    background-color: #000000;
    color: #FFFFFF;
    border: 1px solid #000000;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    cursor: pointer;
    box-sizing: border-box;
    margin-top: 26px;
    overflow: hidden;
    transition: color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .tisso-modal-add-to-cart-btn::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #FFF03F;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .tisso-modal-add-to-cart-btn .tisso-modal-btn-text,
  .tisso-modal-add-to-cart-btn .tisso-modal-btn-arrow {
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .tisso-modal-add-to-cart-btn:hover:not(:disabled) {
    color: #000000;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .tisso-modal-add-to-cart-btn:hover:not(:disabled)::before {
    transform: scaleX(1);
  }

  .tisso-modal-add-to-cart-btn .tisso-modal-btn-arrow {
    display: inline-block;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tisso-modal-add-to-cart-btn:hover:not(:disabled) .tisso-modal-btn-arrow {
    transform: translateX(6px);
  }

  .tisso-modal-add-to-cart-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Status / Notification Toast */
  .tisso-toast-notification {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background-color: #111111;
    color: #FFFFFF;
    padding: 14px 24px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    z-index: 100000;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .tisso-toast-notification.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<!-- Quick View Modal DOM Structure -->
<div id="TissoQuickViewModal" class="tisso-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="TissoModalProductTitle">
  <div class="tisso-modal-dialog">
    <!-- Close Button -->
    <button type="button" class="tisso-modal-close-btn js-tisso-modal-close" aria-label="Close modal">
      <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L14 14M1 14L14 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Product Overview (Image + Details) -->
    <div class="tisso-modal-header">
      <div class="tisso-modal-image-wrapper">
        <img id="TissoModalProductImage" class="tisso-modal-image" src="{{ 'tisso-product-1.png' | asset_url }}" alt="Product Image" width="135" height="135">
      </div>
      <div class="tisso-modal-details">
        <h2 id="TissoModalProductTitle" class="tisso-modal-title"></h2>
        <div id="TissoModalProductPrice" class="tisso-modal-price"></div>
        <p id="TissoModalProductDescription" class="tisso-modal-description"></p>
      </div>
    </div>

    <!-- Variant Option 1: Color -->
    <div class="tisso-option-group" id="TissoColorOptionGroup">
      <label class="tisso-option-label">Color</label>
      <div class="tisso-color-segmented-control" id="TissoColorSegmentedControl" role="radiogroup" aria-label="Product Color Options">
        <!-- Dynamically rendered via custom-modal.js -->
      </div>
    </div>

    <!-- Variant Option 2: Size -->
    <div class="tisso-option-group" id="TissoSizeOptionGroup">
      <label class="tisso-option-label" id="TissoSizeLabel">Size</label>
      <div class="tisso-size-select-wrapper" id="TissoSizeSelectWrapper">
        <button type="button" class="tisso-size-trigger-btn" id="TissoSizeTriggerBtn" aria-haspopup="listbox" aria-expanded="false">
          <span id="TissoSizeTriggerText">Choose your size</span>
          <span class="tisso-size-chevron">
            <svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <ul class="tisso-size-dropdown-menu" id="TissoSizeDropdownMenu" role="listbox" aria-labelledby="TissoSizeLabel">
          <!-- Dynamically rendered via custom-modal.js -->
        </ul>
      </div>
    </div>

    <!-- Add to Cart Action Button -->
    <button type="button" class="tisso-modal-add-to-cart-btn" id="TissoModalAddToCartBtn">
      <span class="tisso-modal-btn-text">ADD TO CART</span>
      <span class="tisso-modal-btn-arrow">
        <svg width="24" height="12" viewBox="0 0 24 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M18 1L23 6M23 6L18 11M23 6H1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>
  </div>
</div>

<!-- Add To Cart Toast Notification Container -->
<div id="TissoToastNotification" class="tisso-toast-notification" aria-live="polite"></div>

<!-- Load Custom Modal Vanilla JS Engine -->
<script src="{{ 'custom-modal.js' | asset_url }}" defer></script>
