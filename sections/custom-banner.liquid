              <path fill-rule="evenodd" clip-rule="evenodd" d="M240.244 25C242.715 25 245.085 25.9817 246.832 27.7292C248.58 29.4766 249.562 31.8466 249.562 34.3179C249.562 36.7892 248.58 39.1592 246.832 40.9067C245.085 42.6541 242.715 43.6358 240.244 43.6358C237.772 43.6358 235.402 42.6541 233.655 40.9067C231.907 39.1592 230.926 36.7892 230.926 34.3179C230.926 31.8466 231.907 29.4766 233.655 27.7292C235.402 25.9817 237.772 25 240.244 25ZM240.242 28.1072C239.427 28.1073 238.619 28.2681 237.865 28.5803C237.111 28.8926 236.427 29.3503 235.85 29.9273C234.685 31.0925 234.03 32.6727 234.031 34.3204C234.031 35.9681 234.685 37.5482 235.851 38.7131C237.016 39.8781 238.596 40.5325 240.244 40.5323C241.891 40.5323 243.472 39.8778 244.637 38.7127C245.802 37.5476 246.456 35.9674 246.456 34.3198C246.456 32.6721 245.802 31.0919 244.637 29.9268C243.472 28.7617 241.891 28.1072 240.244 28.1072H240.242Z" fill="black"/>
