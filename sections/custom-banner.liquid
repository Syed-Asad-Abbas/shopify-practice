            </svg>
          </a>
        </div>
      </div>

      <!-- Mobile Hamburger Dropdown Panel (hidden by default, shown on mobile when hamburger is clicked) -->
      <div class="tisso-mobile-dropdown">
        <p class="tisso-mobile-dropdown-text">
          {{ section.settings.mobile_announcement | default: section.settings.top_announcement | default: 'Find the ideal gift for your loved ones.' }}
        </p>
        <a href="{{ section.settings.mobile_btn_link | default: section.settings.top_btn_link | default: '#products-grid' }}" class="tisso-mobile-dropdown-btn">
          <span class="tisso-mobile-dropdown-btn-text">{{ section.settings.mobile_btn_text | default: section.settings.top_btn_text | default: 'CHOOSE GIFT' }}</span>
          <span class="tisso-mobile-dropdown-btn-line" aria-hidden="true"></span>
        </a>
      </div>

      <div class="tisso-top-center">
        <p class="tisso-announcement-text">
          {{ section.settings.top_announcement | default: 'Find the ideal gift for your loved ones.' }}
        </p>
      </div>

      <div class="tisso-top-right">
        <a href="{{ section.settings.top_btn_link | default: '#products-grid' }}" class="tisso-top-action-btn">
          <span>{{ section.settings.top_btn_text | default: 'CHOOSE GIFT' }}</span>
          <span class="tisso-btn-line" aria-hidden="true"></span>
        </a>
      </div>
    </header>

    <!-- 2. Container 1: Top Illustration Container (1440 x 390 using 1st image.png) -->
    <div class="tisso-hero-top-container">
      <img
        src="{{ top_img_url }}"
        alt="Tisso Vison Line Illustration Top"
        class="tisso-hero-top-img"
        loading="eager"
        width="1440"
        height="390"
      >
    </div>

    <!-- 3. Container 2: Bottom Split (550px Left Content + 890x402 Right using 2nd image.png) -->
    <section class="tisso-hero-bottom-container" aria-label="Hero Gift Guide Banner">
      <!-- Left Column: Content (550px) -->
      <div class="tisso-hero-content-col">
        <h1 class="tisso-hero-heading">
          {{ section.settings.heading | default: 'The Gift Guide' }}
        </h1>

        <div class="tisso-hero-description desktop-only">
          {{
            section.settings.description
            | default: 'Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.'
          }}
        </div>
        <div class="tisso-hero-description mobile-only">
          {{ section.settings.mobile_description | default: 'Discover Joy: Your Ultimate Holiday Gift Destination.' }}
        </div>

        <a href="{{ section.settings.cta_link | default: '#products-grid' }}" class="tisso-hero-cta-btn">
          <span class="tisso-cta-text">{{ section.settings.cta_text | default: 'SHOP NOW' }}</span>
          <span class="tisso-hero-btn-line" aria-hidden="true"></span>
        </a>
      </div>

      <!-- Right Column: 890px x 402px Container (2nd image.png) -->
      <div class="tisso-hero-right-col">
        <img
          src="{{ right_img_url }}"
          alt="Tisso Vison Line Illustration Bottom Right"
          class="tisso-hero-right-img tisso-hero-right-img--desktop"
          loading="eager"
          width="890"
          height="402"
        >
        <img
          src="{{ right_img_mobile_url }}"
          alt="Tisso Hero Mobile"
          class="tisso-hero-right-img tisso-hero-right-img--mobile"
          loading="eager"
        >
      </div>
    </section>
  </div>

  <!-- 4. Bottom Sub-Banner Bar -->
  <div class="tisso-sub-banner">
    <p class="tisso-sub-banner-text tisso-sub-banner-text--desktop">
      {{ section.settings.sub_banner_text | default: 'SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL' }}
    </p>
    <p class="tisso-sub-banner-text tisso-sub-banner-text--mobile" style="display:none;">
      {{ section.settings.mobile_sub_banner_text | default: 'SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR' }}
    </p>
  </div>
</div>

<script>
  (function() {
    const section = document.querySelector('.tisso-banner-section-{{ section.id }}');
    if (!section) return;
    const hamburger = section.querySelector('.tisso-hamburger-menu');
    const dropdown = section.querySelector('.tisso-mobile-dropdown');
    if (!hamburger || !dropdown) return;

    hamburger.addEventListener('click', function() {
      const isOpen = hamburger.classList.toggle('is-active');
      dropdown.classList.toggle('is-open', isOpen);
    });
  })();
</script>

{% schema %}
